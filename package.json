{
  "name": "dsh-skin-qq2007",
  "version": "1.0.0",
  "private": true,
  "description": "Classic QQ 2007 skin for the DeepSeek Harness desktop / web client, ported from Codex-QQ-Skin",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets",
    "LICENSE",
    "NOTICE.md",
    "LICENSES",
    "README.md",
    "screenshots"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "license": "MIT"
}
